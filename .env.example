# Privy App ID - Get from https://dashboard.privy.io
VITE_PRIVY_APP_ID=your-privy-app-id-here

# Alchemy API Key - Get from https://www.alchemy.com/ (for ENS resolution)
VITE_ALCHEMY_API_KEY=your-alchemy-api-key-here

# IPFS Upload - Choose one of the following:

# Pinata - Get from https://pinata.cloud/
VITE_PINATA_JWT=your-pinata-jwt-here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# OR nft.storage - Get from https://nft.storage/
VITE_NFT_STORAGE_KEY=your-nft-storage-api-key-here

# XMTP network: production | dev | local
VITE_XMTP_ENV=production
